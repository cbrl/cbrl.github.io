{
  "version": "2.0.0",
  "tasks": [
	{
		"label": "Install Dependencies",
		"type": "shell",
		"command": "eval \"$(rbenv init -)\" && bundle install",
		"group": {
			"kind": "build"
		},
		"detail": "Installs the required Ruby gems"
	},
    {
      "label": "Run Jekyll Server",
      "type": "shell",
      "command": "eval \"$(rbenv init -)\" && ./tools/run.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Runs the Jekyll server with live reload."
    },
    {
      "label": "Build Jekyll Site",
      "type": "shell",
      "command": "eval \"$(rbenv init -)\" && ./tools/test.sh",
      "group": {
        "kind": "build"
      },
      "problemMatcher": [],
      "detail": "Build the Jekyll site for production."
    }
  ]
}
